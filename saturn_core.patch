diff --git a/src/core/bus.h b/src/core/bus.h
index 4aa625b..823dcfb 100644
--- a/src/core/bus.h
+++ b/src/core/bus.h
@@ -180,7 +180,20 @@ typedef enum {
 #  define N_BUS_SIZE 6
 #  define N_PAGE_TABLE_ENTRIES 16384
 
-#  define N_ROM_SIZE_48 512 * 1024 * 2
+/* 2026-08-21, Cassini patch: right-sized for this project's confirmed,
+   exclusive target (HP48SX) - was hardcoded to the larger HP48GX size
+   regardless of which model actually runs, wasting 512 KiB of the
+   struct BusStatus_48 malloc(). Paired with the matching /2 removal
+   in romram48.c's RomInit48() and the r_size shrink in bus.c's
+   bus_hp48[] ROM module table entry (0xFFFFF -> 0x7FFFF, preserving
+   the exact same "N_ROM_SIZE_48 - 1" relationship the original value
+   already had) - all three must move together, or the ROM module's
+   reset-time address window (bus.c) would stay sized for the old,
+   larger buffer while the buffer itself (this constant) shrinks,
+   opening a real out-of-bounds read window during the brief
+   cold-reset-to-self-configure gap. Scoped to HP48SX only - revert
+   this whole patch before ever targeting HP48GX. */
+#  define N_ROM_SIZE_48 256 * 1024 * 2
 #  define N_RAM_SIZE_48 128 * 1024 * 2
 /* 2.4: Port_1 (CE2) size */
 #  define N_PORT_1_SIZE_48 128 * 1024 * 2
@@ -191,7 +204,7 @@ typedef enum {
    The default value is 8, that is, Port_2 is emulated and its size is 1Mbyte.
  */
 // #define N_PORT_2_BANK_48 ( config.model == MODEL_48GX ? 32 : 1 )
-#  define N_PORT_2_BANK_48 32
+#  define N_PORT_2_BANK_48 1
 /* 2.4: Port_2 (NCE3) size */
 #  define N_PORT_2_SIZE_48 N_PORT_2_BANK_48 * 128 * 1024 * 2
 
