@@ -471,8 +500,19 @@ static void bus_map__replace( bus_map_t** d, const bus_map_t* s )
     if ( *d == ( bus_map_t* )NULL )
         /* Allocation needed; cache cleared after allocation */
         *d = bus_map__copy( bus_map__new(), s );
-    else
+    else {
+        /* 2026-08-21, Cassini patch: *d is an existing, recycled
+           struct about to be overwritten by bus_map__copy() (which
+           calls cache__clear_info_of(), wiping *d's own
+           .cache.unconfig[] array) - release *d's own real backlinks
+           first, before that content is gone. Must happen here, not
+           inside bus_map__copy()/cache__clear_info_of() themselves,
+           since those are also called on freshly-allocated structs
+           whose pre-copy content must never be dereferenced this way -
+           see cache__release_unconfig_refs()'s own comment. */
+        cache__release_unconfig_refs( *d );
         bus_map__copy( *d, s );
+    }
 }
 
