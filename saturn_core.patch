@@ -506,7 +546,14 @@ static void cache__flush_except( bus_map_t* save )
     while ( p != ( bus_map_t* )NULL ) {
         n = p->cache.link;
 
-        if ( p != save )
+        /* 2026-08-21, Cassini patch: .cache.ref_count's own doc
+           comment (bus.h) says it exists "to avoid freeing referenced
+           structures" - this call was freeing them anyway. Now safe
+           to gate on it, since cache__release_unconfig_refs() (added
