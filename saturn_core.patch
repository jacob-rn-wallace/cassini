 }
 
+/* 2026-08-21, Cassini patch: pairs with the two .cache.ref_count++
+   sites (bus_configure(), bus_unconfigure()'s late-hit path) - neither
+   of which was ever paired with a decrement anywhere in this file
+   (confirmed by exhaustive grep). Call this ONLY when `d`'s own
+   .cache.unconfig[] array holds `d`'s own genuine, previously-real
+   backlinks that are about to be discarded/overwritten - i.e. from
+   cache__flush_except() (on `save`, before its own
+   cache__clear_info_of() call) and from bus_map__replace()'s
+   "recycle existing struct" branch (on *d, BEFORE bus_map__copy()
+   overwrites it with `*d = *s`). Deliberately NOT called from
+   bus_map__copy()'s other two call sites (bus_map__replace()'s
+   "allocate new" branch, and bus_unconfigure()'s temp-clone creation)
+   or from bus_init()'s fresh cache__clear_info_of() call: in the
+   fresh-allocation case the pre-copy content is uninitialized
+   malloc() garbage (must never be dereferenced), and in the copy-into-
+   fresh-struct case `*d = *s` has just duplicated `s`'s own still-
+   valid entries into `d` - decrementing there would double-count
+   against a reference that legitimately still exists via `s`. */
+static void cache__release_unconfig_refs( bus_map_t* d )
+{
+    for ( int i = 0; i < N_BUS_SIZE; i++ )
+        if ( d->cache.unconfig[ i ] != ( bus_map_t* )NULL )
+            d->cache.unconfig[ i ]->cache.ref_count--;
+}
+
