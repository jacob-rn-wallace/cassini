+           toward 0 as real backlinks go away, instead of only ever
+           growing. */
+        if ( p != save && p->cache.ref_count == 0 )
             free( p );
 
         p = n;
@@ -516,6 +563,11 @@ static void cache__flush_except( bus_map_t* save )
     save->cache.link = ( bus_map_t* )NULL;
     cache_head = save;
 
+    /* 2026-08-21, Cassini patch: release save's own real backlinks
+       before wiping them below - see cache__release_unconfig_refs()'s
+       own comment for why this is the correct place to do it. */
+    cache__release_unconfig_refs( save );
+
     /* Clear the caching information in 'save' */
     cache__clear_info_of( save );
 }
@@ -1135,6 +1187,13 @@ void bus_configure( Address config_info )
     }
 
 #ifdef USE_BUS_CACHE
+    /* 2026-08-21, Cassini patch: this slot can already hold a real
+       backlink from an earlier visit to this same (cache-hit-
+       reactivated) struct - release it before overwriting, or its
+       target's ref_count would never come back down. */
+    if ( BUS_MAP.cache.unconfig[ mod ] != ( bus_map_t* )NULL )
+        BUS_MAP.cache.unconfig[ mod ]->cache.ref_count--;
+
     /* Set the unconfig cache pointer of module 'mod' to the old BusMap,
        and increment its reference counter, to avoid freeing it
        improperly.
@@ -1244,6 +1303,14 @@ void bus_unconfigure( Address unconfig_info )
 #ifdef USE_BUS_CACHE
     nxt = cache__check_for_late_hit();
     if ( nxt != ( bus_map_t* )NULL ) {
+        /* 2026-08-21, Cassini patch: same reasoning as bus_configure()'s
+           equivalent overwrite above - release whatever this slot
+           already pointed to (cache__unconfig_get() found no
+           config_point hit for it, but the raw slot may still have
+           been non-NULL) before overwriting it. */
+        if ( old->cache.unconfig[ mod ] != ( bus_map_t* )NULL )
+            old->cache.unconfig[ mod ]->cache.ref_count--;
+
         /* Update pointer from the old map to the new one, and increment
            reference counter of the referenced structure
